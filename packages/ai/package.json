{
  "name": "@wildcase/ai",
  "version": "1.0.0",
  "description": "AI provider abstraction, Gemma integrations, Mastra agent workflows and structured Zod parsing for WILDCASE",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "tsx --test src/__tests__/ai.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wildcase/core": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
