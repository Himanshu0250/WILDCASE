{
  "name": "@wildcase/api",
  "version": "1.0.0",
  "description": "Hono REST API, Mastra workflows, MongoDB Atlas persistence, and Sentry observability for WILDCASE",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm",
    "start": "node dist/index.js",
    "test": "tsx --test src/__tests__/api.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@wildcase/ai": "workspace:*",
    "@wildcase/core": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "mongodb": "^6.14.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
