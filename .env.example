# WILDCASE Environment Variables

# Node & Server
NODE_ENV=development
PORT=3001
AUTO_START=true
LOG_LEVEL=info

# Database (MongoDB Atlas) - Optional: Defaults to robust in-memory storage if omitted
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wildcase?retryWrites=true&w=majority
MONGODB_DB_NAME=wildcase

# Open-Weight AI Inference (Gemma)
# For Hosted Gemma:
GEMMA_API_KEY=your_gemma_hosted_api_key_here
GEMMA_ENDPOINT_URL=https://api.together.xyz/v1/chat/completions
GEMMA_MODEL=google/gemma-2-27b-it

# For Local Ollama Development:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# Voice Synthesis (ElevenLabs) - Optional: Automatically falls back to Web Speech Synthesis if omitted
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Error Observability (Sentry) - Optional
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
